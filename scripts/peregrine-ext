#!/usr/bin/env bash
# The server as peregrine._native, standing in for the executable: every test
# suite takes the server's path, and this takes the same arguments.
#
#   bash scripts/integration-test.sh scripts/peregrine-ext
#   PEREGRINE_PYTHON=python3.14t bash scripts/reload-test.sh scripts/peregrine-ext
#
# PEREGRINE_PYTHON is the interpreter to run (default python3); build the module
# for it first with scripts/build-extension.sh. It calls serve() directly rather
# than going through `python -m peregrine`, whose launcher fills in --venv and
# --python-path, so the server sees exactly the command line the executable
# would. exec keeps the pid, so signals from a test reach the supervisor.
ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
export PYTHONPATH="$ROOT/python${PYTHONPATH:+:$PYTHONPATH}"
exec "${PEREGRINE_PYTHON:-python3}" -c '
import sys
import peregrine._native as native
sys.exit(native.serve(["peregrine"] + sys.argv[1:]))
' "$@"
