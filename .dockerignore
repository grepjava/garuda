# The image builds the server from source for its own interpreter, so nothing
# built on the host may reach it: a module for another python would be
# harmless only until something imported it.
python/peregrine/_native*
python/peregrine/_bin
python/peregrine/_swift
**/__pycache__
**/*.egg-info
.build*
build
dist
.git
.pypi-token
graphify-out
