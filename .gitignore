.build/
.build-install/
.build-dist/
.swiftpm/
Package.resolved
build/
dist/
*.egg-info/
*.o
*.pyc
__pycache__/

# The PyPI upload token. A publishing credential, so it lives on the machine
# that publishes and nowhere else -- least of all in a public history, where
# removing it means rewriting every commit after it and rotating the token
# anyway.
.pypi-token

# peregrine._native, built in place by scripts/build-extension.sh.
python/peregrine/_native*.so

# What `bun install` fetches for benchmarks/elysia-bun; upstream keeps no lockfile.
benchmarks/elysia-bun/node_modules/
benchmarks/elysia-bun/bun.lock

# Inputs pgfuzz writes out when it finds something; keep them in
# fuzz/corpus/<target>/ under a name, not here under a seed.
pgfuzz-*.bin

# A local knowledge-graph index of this tree, rebuilt from the source it
# describes. Machine-written, large, and stale the moment anything is edited.
graphify-out/
# The rule and workflow that point an editor's agent at that index.
.agents/rules/graphify.md
.agents/workflows/graphify.md
